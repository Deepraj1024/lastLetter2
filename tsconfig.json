{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "./src/types/*.ts",
    "./src/types/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
